# Copy to .env to override the defaults in app/config.py. All values are optional.

# Signs the login cookie. Change it if the app is ever reachable by others.
# SECRET_KEY=replace-with-a-long-random-string

# How long a login stays valid, in minutes.
# TOKEN_EXPIRE_MINUTES=720

# Where the local database lives.
# DATABASE_URL=sqlite:///D:/some/other/place/packapp.db

# Turns on tracking lookups through Parcelsapp.com (needs internet and a paid key).
# Without it, only the local lookup is used.
# PARCELSAPP_API_KEY=
# PARCELSAPP_COUNTRY=Sweden

# Size of the sticker labels, in millimetres.
# LABEL_WIDTH_MM=100
# LABEL_HEIGHT_MM=150
